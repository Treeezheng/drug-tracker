# Set these in Heroku app drug-tracker → Settings → Config Vars.
# Do not copy credentials into this file or commit an exported Heroku config.
CLOUD_ORIGIN=https://drug-tracker-7e9d0c2e62c1.herokuapp.com
DATABASE_POOL_SIZE=4
# Optional override; the Heroku buildpack stack already includes this verified CA bundle.
DATABASE_CA_PATH=/usr/lib/ssl/certs/ca-certificates.crt
# DATABASE_URL is supplied by the attached PostgreSQL add-on. Never paste it into source.
# PORT and DYNO are supplied by Heroku. Do not set them manually.
# Do not set CLOUD_DB_PATH, CLOUD_ALLOW_INSECURE_LOOPBACK, CLOUD_ADMIN_PASSWORD,
# DRUG_POSTGRES_ALLOW_INSECURE_LOOPBACK, DRUG_BUILD_OUT_DIR, or local-edition build flags.
