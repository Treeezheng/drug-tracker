# Non-secret service configuration. Install as /etc/drug-tracker/cloud.env.
# This is NOT the local Mac database. Its parent must belong to drug-tracker.
CLOUD_DB_PATH=/var/lib/drug-tracker/cloud.sqlite
CLOUD_ORIGIN=https://treeezh.com
CLOUD_PORT=4312
CLOUD_PROXY_MODE=caddy-loopback
CLOUD_DIST_PATH=/opt/drug-tracker/current/dist

# No account password, recovery code, data key or session token belongs here.
# Accounts register securely in the webpage; CLI password bootstrap is disabled.
# CLOUD_ALLOW_INSECURE_LOOPBACK must remain unset in this HTTPS deployment.
# caddy-loopback requires the matching Caddyfile header override and a loopback-only backend.
# This template is for Caddy as the public edge, not an unreviewed CDN/proxy chain.
